{
  "expo": {
    "name": "Bosko",
    "slug": "Bosko",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bosko-logo.png",
    "scheme": "bosko",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#850021"
    },

    "android": {
      "package": "com.boskoapp.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#850021"
      },
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "androidNavigationBar": {
        "backgroundColor": "#000000",
        "barStyle": "light"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.VIBRATE"
      ]
    },

    "ios": {
      "bundleIdentifier": "com.boskoapp.mobile",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Bosko necesita acceso a tu cámara para tomar fotos de perfil y servicios.",
        "NSPhotoLibraryUsageDescription": "Bosko necesita acceso a tu galería para subir fotos de perfil y servicios.",
        "NSMicrophoneUsageDescription": "Bosko necesita acceso al micrófono para enviar mensajes de voz."
      }
    },

    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      ["expo-navigation-bar", { "backgroundColor": "#000000" }],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bosko necesita acceso a tu galería para subir fotos.",
          "cameraPermission": "Bosko necesita acceso a tu cámara."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Bosko necesita acceso al micrófono para mensajes de voz."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ],

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "481e79c0-a1dd-409f-a1d0-af9bd2881eb8"
      }
    }
  }
}
