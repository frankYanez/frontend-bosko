{
  "name": "bosko-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "adb-reverse": "PORT=$(adb mdns services 2>/dev/null | grep '_adb-tls-connect._tcp' | head -1 | awk '{print $NF}') && adb connect $PORT && adb -s $PORT reverse tcp:8081 tcp:8081 && echo \"Reverse OK: $PORT\"",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll=false"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/src/tests/e2e/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "dependencies": {
    "@didit-protocol/sdk-react-native": "^4.0.6",
